rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ==========================================
    // 1. PROFILE PHOTOS (Users & Juniors)
    // ==========================================
    match /profile-photos/{filename} {
      allow read: if true; // Anyone can view profile photos
      
      // FIXED SECURITY: Combined Auth, Filename, Size, and Type into ONE rule
      allow write: if request.auth != null 
        && (
          filename == request.auth.uid + '.jpg' || 
          filename.matches(request.auth.uid + '_junior_[0-9]+\\.jpg')
        )
        && request.resource.size < 10 * 1024 * 1024 // 10MB max
        && request.resource.contentType.matches('image/.*'); // Must be an image
      
      // Deleting only requires the Auth and Filename check
      allow delete: if request.auth != null 
        && (
          filename == request.auth.uid + '.jpg' || 
          filename.matches(request.auth.uid + '_junior_[0-9]+\\.jpg')
        );
    }

    // ==========================================
    // 2. GALLERY MARKETING PHOTOS (Admin Only)
    // ==========================================
    match /gallery/{filename} {
      allow read: if true;
      
      // Admin Auth AND Size Limit AND Image Type check
      allow write: if request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email == 'kartcade.website@gmail.com' ||
        request.auth.token.email == 'adamjames9@gmail.com' ||
        request.auth.token.email == 'info@kartcade.com'
      ) 
      && request.resource.size < 20 * 1024 * 1024 // 20MB max
      && request.resource.contentType.matches('image/.*'); // Must be an image

      // Delete check - Admin only
      allow delete: if request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email == 'kartcade.website@gmail.com' ||
        request.auth.token.email == 'adamjames9@gmail.com' ||
        request.auth.token.email == 'info@kartcade.com'
      );
    }
    
  }
}
