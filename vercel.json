{
    "cleanUrls": true,
    "functions": {
        "api/**/*.ts": {
            "includeFiles": "api/services/**",
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/)(?!.*\\.).*)",
            "destination": "/app"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/marketing-sync",
            "schedule": "0 14 * * *"
        }
    ]
}
