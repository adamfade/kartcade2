rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if the requesting user is an admin
    function isAdmin() {
      // email_verified: anyone can create an unverified account using an admin's address
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email == 'kartcade.website@gmail.com' ||
        request.auth.token.email == 'adamjames9@gmail.com' ||
        request.auth.token.email == 'info@kartcade.com'
      );
    }

    // Gallery collection - Public read, Admin write
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Parties collection - For party bookings and guest registry
    match /parties/{partyId} {
      // Anyone can read a party (needed for guests to view invite links)
      allow read: if true; 
      
      // Any authenticated user can create a party (when booking)
      allow create: if request.auth != null;
      
      // Host or admin can update anything; any signed-in guest may only add themselves to the guest list
      allow update: if isAdmin()
        || (request.auth != null && resource.data.hostUserId == request.auth.uid)
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredGuests', 'updatedAt'])
            && request.resource.data.registeredGuests.size() == resource.data.get('registeredGuests', []).size() + 1);
      
      // Only admins can delete a party (prevent accidental deletions)
      allow delete: if isAdmin();
    }
    
    // Users collection - each user can read/write their own document
    // Admins can read ALL user documents (for CRM)
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Users can create their own profile (on signup)
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can update their own profile (but not 'role'), admins can update any user
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin()
      );
      
      // No one can delete user profiles (admin does this manually if needed)
      allow delete: if false;
    }
    
    // Transactions Log (CRM) - permanent booking/membership records
    match /transactions_log/{transactionId} {
      // Admins can read all, regular users can read their own
      allow read: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.userId
      );
      // Any authenticated user can create (logged at booking time)
      // Admins can also update (for sync, cancellation)
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Memberships collection (future)
    match /memberships/{membershipId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // Only admin/backend can write - for now manual
    }
    
    // Transactions collection (future)
    match /transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // Only admin/backend can write
    }
    
    // Lap Times — Fastest Lap feature
    match /lap_times/{lapId} {
      // Anyone can read approved times (public leaderboard)
      allow read: if resource.data.status == 'approved' || 
                     (request.auth != null && request.auth.uid == resource.data.userId) ||
                     isAdmin();
      // Any authenticated user can submit their own lap time
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Only admins can update (approve/reject)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Competitions — created and managed by admins only
    match /competitions/{compId} {
      allow read: if true; // Public — visible on leaderboard
      allow write: if isAdmin();
    }
    
    // Track builder library — saved track projects (route, options, placed scenery). Admins only.
    match /trackProjects/{projectId} {
      allow read, write: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
